{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/cards/**",
              "components/core/**",
              "components/machines/**",
              "components/mate/**",
              "components/quota/**",
              "components/voice/**",
              "ui_kits/firstmate/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color \u2014 use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value \u2014 use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Space Grotesk|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Space Grotesk, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityFeedEvent'] > JSXAttribute > JSXIdentifier[name!=/^(?:time|kind|text|key|ref|className|style|children)$/]",
        "message": "<ActivityFeedEvent> doesn't accept that prop. Declared props: time, kind, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='ActivityFeedEvent'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:spawn|report|done)$/]",
        "message": "<ActivityFeedEvent> kind must be one of 'spawn' | 'report' | 'done'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|mono|dot|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, mono, dot, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|ok|warn|danger|outline)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'accent' | 'ok' | 'warn' | 'danger' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlotBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:slot|style|key|ref|className|style|children)$/]",
        "message": "<SlotBadge> doesn't accept that prop. Declared props: slot, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SlotBadge'] > JSXAttribute[name.name='slot'] > Literal[value!=/^(?:premium|high|medium|low)$/]",
        "message": "<SlotBadge> slot must be one of 'premium' | 'high' | 'medium' | 'low'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|pending|pendingLabel|off|note|aria-description|icon|children|onClick|aria-haspopup|aria-expanded|autoFocus|tabIndex|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, pending, pendingLabel, off, note, aria-description, icon, children, onClick, aria-haspopup, aria-expanded, autoFocus, tabIndex, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CardStack'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|count|unreadBefore|unreadAfter|onPrev|onNext|prevKeys|nextKeys|width|children|peekStyle|envelopeHeight|style|key|ref|className|style|children)$/]",
        "message": "<CardStack> doesn't accept that prop. Declared props: index, count, unreadBefore, unreadAfter, onPrev, onNext, prevKeys, nextKeys, width, children, peekStyle, envelopeHeight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Crewmate'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|size|style|key|ref|className|style|children)$/]",
        "message": "<Crewmate> doesn't accept that prop. Declared props: status, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Crewmate'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:working|idle)$/]",
        "message": "<Crewmate> status must be one of 'working' | 'idle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CrewStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:working|idle|queued|waiting|style|key|ref|className|style|children)$/]",
        "message": "<CrewStrip> doesn't accept that prop. Declared props: working, idle, queued, waiting, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Firstmate'] > JSXAttribute > JSXIdentifier[name!=/^(?:state|size|level|kick|style|key|ref|className|style|children)$/]",
        "message": "<Firstmate> doesn't accept that prop. Declared props: state, size, level, kick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Firstmate'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:idle|listening|working|thinking)$/]",
        "message": "<Firstmate> state must be one of 'idle' | 'listening' | 'working' | 'thinking'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|keys|size|tone|disabled|off|children|onClick|onFocus|aria-haspopup|aria-expanded|aria-disabled|aria-keyshortcuts|tabIndex|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: label, keys, size, tone, disabled, off, children, onClick, onFocus, aria-haspopup, aria-expanded, aria-disabled, aria-keyshortcuts, tabIndex, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|accent|danger|ok)$/]",
        "message": "<IconButton> tone must be one of 'neutral' | 'accent' | 'danger' | 'ok'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|mono|size|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: placeholder, value, onChange, mono, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Input> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyCap'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|key|ref|className|style|children)$/]",
        "message": "<KeyCap> doesn't accept that prop. Declared props: children, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeyCap'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<KeyCap> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MachineRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|detail|summary|state|tone|busy|action|style|key|ref|className|style|children)$/]",
        "message": "<MachineRow> doesn't accept that prop. Declared props: name, detail, summary, state, tone, busy, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MachineRow'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ok|warn|idle)$/]",
        "message": "<MachineRow> tone must be one of 'ok' | 'warn' | 'idle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuotaMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|percentRemaining|pace|resetText|style|key|ref|className|style|children)$/]",
        "message": "<QuotaMeter> doesn't accept that prop. Declared props: label, percentRemaining, pace, resetText, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuotaMeter'] > JSXAttribute[name.name='pace'] > Literal[value!=/^(?:ahead|on_pace|behind|unknown)$/]",
        "message": "<QuotaMeter> pace must be one of 'ahead' | 'on_pace' | 'behind' | 'unknown'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResponseCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|chrome|recordTaskId|title|titleWords|taskKey|meta|place|model|actions|attachment|facts|aside|onClose|closeRef|closeAsk|closeAsking|children|width|minHeight|surface|headExtra|revised|footer|replyBelow|bare|style|bodyStyle|key|ref|className|style|children)$/]",
        "message": "<ResponseCard> doesn't accept that prop. Declared props: kind, chrome, recordTaskId, title, titleWords, taskKey, meta, place, model, actions, attachment, facts, aside, onClose, closeRef, closeAsk, closeAsking, children, width, minHeight, surface, headExtra, revised, footer, replyBelow, bare, style, bodyStyle."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResponseCard'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:decision|note|attention|record)$/]",
        "message": "<ResponseCard> kind must be one of 'decision' | 'note' | 'attention' | 'record'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubscriptionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:provider|plan|account|status|windows|models|onToggleModel|width|style|key|ref|className|style|children)$/]",
        "message": "<SubscriptionCard> doesn't accept that prop. Declared props: provider, plan, account, status, windows, models, width, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SubscriptionCard'] > JSXAttribute[name.name='status'] > Literal[value!=/^(?:fresh|stale|auth_required|rate_limited|error)$/]",
        "message": "<SubscriptionCard> status must be one of 'fresh' | 'stale' | 'auth_required' | 'rate_limited' | 'error'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoiceInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:mode|keybindHint|disabled|value|onChange|level|onActivate|onAbandon|onAccept|onSubmit|onFocusChange|onKeystroke|width|style|inputRef|shellRef|maxHeight|attachments|onAttach|onPictureTooBig|onRemoveAttachment|onPaste|pastes|onPasteText|onInlinePaste|onRemovePaste|onCaretChange|onRecall|key|ref|className|style|children)$/]",
        "message": "<VoiceInput> doesn't accept that prop. Declared props: mode, keybindHint, disabled, value, onChange, level, onActivate, onAbandon, onAccept, onSubmit, onFocusChange, onKeystroke, width, style, inputRef, shellRef, maxHeight, attachments, onAttach, onPictureTooBig, onRemoveAttachment, onPaste, pastes, onPasteText, onInlinePaste, onRemovePaste, onCaretChange, onRecall."
      },
      {
        "selector": "JSXOpeningElement[name.name='VoiceInput'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:idle|recording)$/]",
        "message": "<VoiceInput> mode must be one of 'idle' | 'recording'."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuotaMicroMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|percentRemaining|pace|resetText|clockPercent|stale|style|key|ref|className|style|children)$/]",
        "message": "<QuotaMicroMeter> doesn't accept that prop. Declared props: label, percentRemaining, pace, resetText, clockPercent, stale, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuotaMicroMeter'] > JSXAttribute[name.name='pace'] > Literal[value!=/^(?:ahead|on_pace|behind|unknown)$/]",
        "message": "<QuotaMicroMeter> pace must be one of 'ahead' | 'on_pace' | 'behind' | 'unknown'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|label|style|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: tone, label, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ok|ring|warn|danger|idle|busy|captain)$/]",
        "message": "<StatusDot> tone must be one of 'ok' | 'ring' | 'warn' | 'danger' | 'idle' | 'busy' | 'captain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RowMenu'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|items|size|word|style|triggerTabIndex|restoreFocus|key|ref|className|style|children)$/]",
        "message": "<RowMenu> doesn't accept that prop. Declared props: label, items, size, word, style, triggerTabIndex, restoreFocus."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
