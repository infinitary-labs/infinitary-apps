{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**", "tests/**", "*.ts", "*.tsx", "*.json", "*.md", "!.claude", "!.lavish"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": ["@earendil-works/pi-coding-agent", "@earendil-works/pi-ai"],
                "message": "Pi APIs are reachable only through the adapter seam in src/core/pi/ (docs/architecture.md §17 cross-cutting rules)."
              },
              {
                "group": ["@anthropic-ai/claude-agent-sdk", "@anthropic-ai/sdk"],
                "message": "Claude's client is reachable only through the adapter seam in src/core/claude/ (account-broker phase 7)."
              }
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "trailingCommas": "all",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "plugins": ["./tests/lint/platform-reader.grit"]
    },
    {
      "includes": ["tests/e2e/**"],
      "plugins": [
        "./tests/lint/e2e-no-ms-budgets.grit",
        "./tests/lint/e2e-structural-selectors.grit",
        "./tests/lint/e2e-measured-box.grit",
        "./tests/lint/e2e-layout-state.grit",
        "./tests/lint/e2e-model-id-literal.grit",
        "./tests/lint/e2e-feed-line-prose.grit",
        "./tests/lint/e2e-run-evidence-path.grit",
        "./tests/lint/e2e-typed-keys.grit",
        "./tests/lint/e2e-firstmate-pose.grit",
        "./tests/lint/e2e-frame-door.grit",
        "./tests/lint/e2e-bare-focus.grit",
        "./tests/lint/e2e-text-lookup.grit",
        "./tests/lint/e2e-scenario-imports.grit"
      ]
    },
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["electron", "electron/*", "electron/**"],
                    "message": "src/core/ is the Electron-free application core (daemon study D1): it must run under any host. Reach the desktop shell through HostCapabilities (src/core/host.ts) instead."
                  },
                  {
                    "group": [
                      "../main/**",
                      "../../main/**",
                      "../../../main/**",
                      "../../../../main/**"
                    ],
                    "message": "src/core/ may not import the host tree (src/main/): the dependency runs host -> core, never back."
                  },
                  {
                    "group": ["@earendil-works/pi-coding-agent", "@earendil-works/pi-ai"],
                    "message": "Pi APIs are reachable only through the adapter seam in src/core/pi/ (docs/architecture.md §17 cross-cutting rules)."
                  },
                  {
                    "group": ["@anthropic-ai/claude-agent-sdk", "@anthropic-ai/sdk"],
                    "message": "Claude's client is reachable only through the adapter seam in src/core/claude/ (account-broker phase 7)."
                  },
                  {
                    "group": [
                      "./decisions/jev/**",
                      "../decisions/jev/**",
                      "../../decisions/jev/**",
                      "../../../decisions/jev/**"
                    ],
                    "message": "A native decision model's client and key store are reachable only through src/core/decisions/ (S7b): nothing else may build a request to that endpoint or read that key."
                  },
                  {
                    "group": [
                      "./forge/providers/**",
                      "../forge/providers/**",
                      "../../forge/providers/**",
                      "../../../forge/providers/**"
                    ],
                    "message": "A forge provider file is reachable only through src/core/forge/index.ts (git integration PR 1.1): only src/core/forge/ and the composition root (src/core/services.ts) may import one."
                  }
                ]
              }
            }
          }
        }
      }
    },
