{
  "name": "infinitary-docs-site",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node ../scripts/docs-site-whats-new.ts && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "build": "node ../scripts/docs-site-whats-new.ts && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "check": "node scripts/check-site.mjs",
    "test": "node --test scripts/*.test.mjs",
    "rehearse": "WRANGLER_SEND_METRICS=false wrangler deploy --dry-run --outdir .wrangler/rehearsal",
    "preflight": "node scripts/cloudflare-docs.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.10",
    "astro": "7.4.8"
  },
  "devDependencies": {
    "playwright": "1.62.1",
    "wrangler": "4.159.0"
  }
}
