---
// The wordmark as getinfinitary.com and the design system draw it: the name in
// Space Grotesk 500 in the text color, never the accent, beside the app icon
// reduced to its two hexagons, without the icon's dark tile.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="wordmark">
  <svg class="mark" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
    <path class="mark-in" d="M14.3 8H9.7L7.4 12l2.3 4h4.6l2.3-4z"></path>
    <path class="mark-out" d="M12 3.2l7.6 4.4v8.8L12 20.8l-7.6-4.4V7.6z"></path>
    <g class="mark-dot">
      <circle cx="12" cy="3.2" r="1.25"></circle>
      <circle cx="19.6" cy="7.6" r="1.25"></circle>
      <circle cx="19.6" cy="16.4" r="1.25"></circle>
      <circle cx="12" cy="20.8" r="1.25"></circle>
      <circle cx="4.4" cy="16.4" r="1.25"></circle>
      <circle cx="4.4" cy="7.6" r="1.25"></circle>
      <circle cx="12" cy="12" r="1.1"></circle>
    </g>
  </svg>
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--fg-1);
    font-family: var(--sl-font);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  .mark {
    display: block;
    flex: none;
  }
  .mark-out,
  .mark-in {
    fill: none;
    stroke-linejoin: round;
  }
  .mark-out {
    stroke: var(--accent);
    stroke-width: 1.3;
  }
  .mark-in {
    stroke: var(--fg-3);
    stroke-width: 1;
  }
  .mark-dot {
    fill: var(--accent);
  }
</style>
