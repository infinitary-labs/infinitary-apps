// The Cloudflare Worker that serves docs.getinfinitary.com (docs/docs-site.md,
// "Publishing"). It runs no code of its own: Cloudflare's asset server answers
// every request from the built files in dist/, with the headers the build
// writes to dist/_headers.
//
// Nothing here publishes on its own. The only publication path is
// .github/workflows/docs-site-publish.yml, on main. The account comes from the
// run's CLOUDFLARE_ACCOUNT_ID secret; no identifier or key lives here.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "infinitary-docs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // An unknown address answers 404 with the site's own not-found page.
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // The site's only address. Cloudflare creates its DNS record and certificate.
  "routes": [{ "pattern": "docs.getinfinitary.com", "custom_domain": true }],
  // Both default to publishing extra copies of the site on workers.dev hosts.
  "workers_dev": false,
  "preview_urls": false,
  // No Workers Logs, traces or source maps, and the publish tool sends no metrics.
  "observability": { "enabled": false },
  "upload_source_maps": false,
  "send_metrics": false
}
