<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<!-- The languages iOS offers on the app's page in its Settings: each catalog language, as scripts/generate-messages.ts checks. -->
<key>CFBundleDevelopmentRegion</key><string>en</string>
<key>CFBundleLocalizations</key><array><string>en</string><string>ar</string><string>de</string><string>es</string><string>fr</string><string>ja</string><string>ko</string><string>pt-BR</string><string>zh-Hans</string><string>zh-Hant</string></array>
<key>CFBundleDisplayName</key><string>Infinitary</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<!-- INF-1066: permit ProMotion; the display and power state still choose the delivered cadence. -->
<key>CADisableMinimumFrameDurationOnPhone</key><true/>
<key>LSRequiresIPhoneOS</key><true/>
<!-- swift-certificates builds the phone's sign-in certificate and brings BoringSSL as a dependency; connections use iOS TLS. -->
<key>ITSAppUsesNonExemptEncryption</key><false/>
<key>CFBundleURLTypes</key><array><dict><key>CFBundleURLName</key><string>com.getinfinitary.infinitary.join</string><key>CFBundleURLSchemes</key><array><string>infinitary</string></array></dict></array>
<!-- The void background in each appearance, generated from the design skill by scripts/generate-phone-theme.ts. -->
<key>UILaunchScreen</key><dict><key>UIColorName</key><string>LaunchBackground</string></dict>
<key>UIApplicationSceneManifest</key><dict><key>UIApplicationSupportsMultipleScenes</key><false/></dict>
<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
<key>UISupportedInterfaceOrientations~ipad</key><array><string>UIInterfaceOrientationPortrait</string><string>UIInterfaceOrientationPortraitUpsideDown</string><string>UIInterfaceOrientationLandscapeLeft</string><string>UIInterfaceOrientationLandscapeRight</string></array>
<key>NSLocalNetworkUsageDescription</key><string>Infinitary finds your computer and reads its cards and Activity on your network, and lists the computers here with Remote Login on when you join by an address.</string>
<key>NSFaceIDUsageDescription</key><string>Infinitary asks for Face ID before each use of your secrets you allow from this device.</string>
<key>NSCameraUsageDescription</key><string>Infinitary scans the code you open in Devices on your computer so this phone can join it, and takes the photos you add to a reply.</string>
<key>NSBonjourServices</key><array><string>_infinitary._tcp</string><string>_ssh._tcp</string></array>
<!-- INF-1903: iOS counts a Tailscale address (100.64.0.0/10) as not local and fails the Mac's self-signed certificate there; PinnedTransport checks the Mac's pin itself (docs/ios.md). -->
<key>NSAppTransportSecurity</key><dict><key>NSAllowsArbitraryLoads</key><true/></dict>
<key>UIAppFonts</key><array><string>SpaceGrotesk.ttf</string><string>JetBrainsMono.ttf</string></array>
</dict></plist>
