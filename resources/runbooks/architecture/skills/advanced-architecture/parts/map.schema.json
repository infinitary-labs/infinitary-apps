{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A folder's map file, .architecture.json",
  "description": "Names, groups, links with why and state machines for one folder of a project. It never lists files, lines or counts.",
  "type": "object",
  "required": ["name", "parts"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1, "description": "The folder's name in the project's own words." },
    "about": { "type": "string", "description": "One sentence on what the folder is for." },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "why"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1, "description": "What its parts share, such as where they run." }
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "path"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "path": {
            "type": "string",
            "pattern": "^[^/]([^/]|/[^/])*$",
            "description": "The part's folder from the project's top, inside this map file's folder; never a file."
          },
          "about": { "type": "string" },
          "group": { "type": "string", "description": "The name of one of this file's groups." }
        }
      }
    },
    "outside": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "about": { "type": "string" },
          "path": { "type": "string", "description": "Only for something outside this folder that is still in the project: its folder from the project's top." }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "why"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "description": "The part or outside box that uses." },
          "to": { "type": "string", "description": "The part or outside box it uses." },
          "why": { "type": "string", "minLength": 1, "description": "What the use is for, in a few words." }
        }
      }
    },
    "machines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "in", "states", "moves"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "description": "Unique across the whole map, such as a task or a payment." },
          "in": { "type": "string", "description": "The name of the part in this file whose code holds it." },
          "about": { "type": "string" },
          "states": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 }, "description": "The first state first." },
          "moves": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from", "to", "why"],
              "additionalProperties": false,
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" },
                "why": { "type": "string", "minLength": 1 },
                "by": { "type": "string", "description": "The part or outside box in this file whose code makes the move." }
              }
            }
          },
          "opens": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "description": "A state that starts another machine, mapped to that machine's name."
          }
        }
      }
    },
    "place": {
      "type": "object",
      "description": "Optional: a part, group or outside box by name, mapped to its [column, row]. Leave it out to have boxes placed by their links.",
      "additionalProperties": {
        "type": "array",
        "prefixItems": [{ "type": "integer", "minimum": 0 }, { "type": "integer", "minimum": 0 }],
        "minItems": 2,
        "maxItems": 2
      }
    }
  }
}
